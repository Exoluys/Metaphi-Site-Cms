{
  "kind": "collectionType",
  "collectionName": "industries",
  "info": {
    "singularName": "industry",
    "pluralName": "industries",
    "displayName": "Industry",
    "description": "CMS-driven industries for MetaPhi"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "slug": {
      "type": "string",
      "required": false
    },
    "title": {
      "type": "string",
      "required": true
    },
    "summary": {
      "type": "text"
    },
    "body": {
      "type": "text"
    },
    "icon": {
      "type": "string"
    },
    "heroImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "order": {
      "type": "integer",
      "default": 0,
      "min": 0
    },
    "heroSection": {
      "type": "component",
      "repeatable": false,
      "component": "industry-page.hero-section"
    },
    "reviewers": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::reviewer.reviewer"
    },
    "trustBar": {
      "type": "component",
      "repeatable": false,
      "component": "industry-page.trust-bar"
    },
    "clientLogos": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::client-logo.client-logo"
    },
    "stats": {
      "type": "component",
      "repeatable": true,
      "component": "industry-page.stat-item"
    },
    "challengesSection": {
      "type": "component",
      "repeatable": false,
      "component": "industry-page.challenges-section"
    },
    "caseStudiesSection": {
      "type": "component",
      "repeatable": false,
      "component": "industry-page.case-studies-section"
    },
    "caseStudies": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::case-study.case-study",
      "mappedBy": "industries"
    },
    "solutionsSection": {
      "type": "component",
      "repeatable": false,
      "component": "industry-page.solutions-section"
    },
    "servicesSection": {
      "type": "component",
      "repeatable": false,
      "component": "industry-page.services-section"
    },
    "verticalsSection": {
      "type": "component",
      "repeatable": false,
      "component": "industry-page.verticals-section"
    },
    "techStackSection": {
      "type": "component",
      "repeatable": false,
      "component": "industry-page.tech-stack-section"
    },
    "ctaBanner": {
      "type": "component",
      "repeatable": false,
      "component": "industry-page.cta-banner"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}
