{
  "kind": "collectionType",
  "collectionName": "industries",
  "info": {
    "singularName": "industry",
    "pluralName": "industries",
    "displayName": "Industry",
    "description": "CMS-driven industries for MetaPhi"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "slug": {
      "type": "string",
      "required": false
    },
    "title": {
      "type": "string",
      "required": true
    },
    "summary": {
      "type": "text"
    },
    "body": {
      "type": "text"
    },
    "icon": {
      "type": "string"
    },
    "heroImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "seoDescription": {
      "type": "string",
      "maxLength": 160
    },
    "order": {
      "type": "integer",
      "default": 0,
      "min": 0
    },
    "heroSection": {
      "type": "component",
      "repeatable": false,
      "component": "industry.hero-section"
    },
    "servicesSection": {
      "type": "component",
      "repeatable": false,
      "component": "industry.services-section"
    },
    "capabilitiesSection": {
      "type": "component",
      "repeatable": false,
      "component": "industry.capabilities-section"
    },
    "engagementSection": {
      "type": "component",
      "repeatable": false,
      "component": "industry.engagement-section"
    },
    "caseStudies": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::case-study.case-study",
      "mappedBy": "industries"
    },
    "sections": {
      "type": "component",
      "component": "shared.section",
      "repeatable": true
    }
  }
}
