{
  "kind": "collectionType",
  "collectionName": "industries",
  "info": {
    "singularName": "industry",
    "pluralName": "industries",
    "displayName": "Industries",
    "description": "CMS-driven industries for MetaPhi"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": false
    },
    "summary": {
      "type": "text",
      "maxLength": 300
    },
    "order": {
      "type": "integer",
      "required": false,
      "default": 0,
      "min": 0
    },
    "heroImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "heroHeadline": {
      "type": "string"
    },
    "heroSubtext": {
      "type": "text"
    },
    "ctaPrimaryLabel": {
      "type": "string"
    },
    "ctaSecondaryLabel": {
      "type": "string"
    },
    "industryContextHeading": {
      "type": "string"
    },
    "industryContext": {
      "type": "text"
    },
    "commonChallengesHeading": {
      "type": "string"
    },
    "commonChallenges": {
      "type": "component",
      "repeatable": true,
      "component": "hub.string-item"
    },
    "techOpportunitiesHeading": {
      "type": "string"
    },
    "techOpportunities": {
      "type": "text"
    },
    "howMetaphiHelpsHeading": {
      "type": "string"
    },
    "howMetaphiHelps": {
      "type": "component",
      "repeatable": true,
      "component": "hub.string-item"
    },
    "relevantCustomSolutionsHeading": {
      "type": "string"
    },
    "relevantCustomSolutions": {
      "type": "component",
      "repeatable": true,
      "component": "hub.title-description"
    },
    "readyToConfigureSolutionsHeading": {
      "type": "string"
    },
    "readyToConfigureSolutions": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::solution.solution"
    },
    "keyUseCasesHeading": {
      "type": "string"
    },
    "keyUseCases": {
      "type": "component",
      "repeatable": true,
      "component": "hub.string-item"
    },
    "aiOpportunitiesHeading": {
      "type": "string"
    },
    "aiOpportunities": {
      "type": "component",
      "repeatable": true,
      "component": "hub.string-item"
    },
    "integrationsHeading": {
      "type": "string"
    },
    "integrations": {
      "type": "component",
      "repeatable": true,
      "component": "hub.string-item"
    },
    "caseStudiesHeading": {
      "type": "string"
    },
    "caseStudies": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::case-study.case-study"
    },
    "transformationApproachHeading": {
      "type": "string"
    },
    "transformationApproachText": {
      "type": "text"
    },
    "transformationApproachCtaLabel": {
      "type": "string"
    },
    "playbookHeading": {
      "type": "string"
    },
    "playbookSubtext": {
      "type": "text"
    },
    "playbookCtaLabel": {
      "type": "string"
    },
    "faqs": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::faq.faq"
    },
    "solutions": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::solution.solution",
      "inversedBy": "industries"
    },
    "primarySeoTheme": {
      "type": "string"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}
