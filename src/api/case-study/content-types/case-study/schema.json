{
  "kind": "collectionType",
  "collectionName": "case_studies",
  "info": {
    "singularName": "case-study",
    "pluralName": "case-studies",
    "displayName": "Case Study",
    "description": "CMS-driven case studies for MetaPhi"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "slug": {
      "type": "string",
      "required": false
    },
    "title": {
      "type": "string",
      "required": true
    },
    "subtitle": {
      "type": "text"
    },
    "summary": {
      "type": "text"
    },
    "body": {
      "type": "text"
    },
    "tags": {
      "type": "text"
    },
    "heroImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "seoDescription": {
      "type": "string",
      "maxLength": 160
    },
    "order": {
      "type": "integer",
      "default": 0,
      "min": 0
    },
    "projectSummary": {
      "type": "component",
      "component": "case-study.project-summary-section",
      "repeatable": false
    },
    "challengeSection": {
      "type": "component",
      "component": "case-study.challenge-section",
      "repeatable": false
    },
    "solutionSection": {
      "type": "component",
      "component": "case-study.solution-section",
      "repeatable": false
    },
    "workflowSection": {
      "type": "component",
      "component": "case-study.workflow-section",
      "repeatable": false
    },
    "technologySection": {
      "type": "component",
      "component": "case-study.technology-section",
      "repeatable": false
    },
    "impactSection": {
      "type": "component",
      "component": "case-study.impact-section",
      "repeatable": false
    },
    "takeawaysSection": {
      "type": "component",
      "component": "case-study.takeaways-section",
      "repeatable": false
    },
    "relatedServices": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::service.service",
      "inversedBy": "caseStudiesList"
    },
    "industries": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::industry.industry",
      "inversedBy": "caseStudies"
    }
  }
}
