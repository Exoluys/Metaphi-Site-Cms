{
  "kind": "collectionType",
  "collectionName": "case_studies",
  "info": {
    "singularName": "case-study",
    "pluralName": "case-studies",
    "displayName": "Case Study",
    "description": "CMS-driven case studies for MetaPhi"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "slug": {
      "type": "string",
      "required": false
    },
    "title": {
      "type": "string",
      "required": true
    },
    "order": {
      "type": "integer",
      "default": 0,
      "min": 0
    },
    "subtitle": {
      "type": "text"
    },
    "summary": {
      "type": "text"
    },
    "tags": {
      "type": "text"
    },
    "heroImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "solutionText": {
      "type": "text"
    },
    "solutions": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::solution.solution",
      "inversedBy": "caseStudies"
    },
    "projectSummary": {
      "type": "component",
      "component": "case-study.project-summary-section",
      "repeatable": false
    },
    "challengeSection": {
      "type": "component",
      "component": "case-study.challenge-section",
      "repeatable": false
    },
    "impactSection": {
      "type": "component",
      "component": "case-study.impact-section",
      "repeatable": false
    }
  }
}
