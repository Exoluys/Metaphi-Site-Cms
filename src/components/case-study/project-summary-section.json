{
  "collectionName": "components_case_study_project_summaries",
  "info": {
    "displayName": "Project Summary Section",
    "icon": "information",
    "description": "Project summary section with client logo, summary text, key facts and headline stats"
  },
  "options": {},
  "attributes": {
    "clientLogo": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "summaryText": {
      "type": "text",
      "maxLength": 160
    },
    "keyFacts": {
      "type": "component",
      "component": "case-study.key-fact",
      "repeatable": true,
      "required": false,
      "max": 3
    },
    "headlineStats": {
      "type": "component",
      "component": "case-study.stat",
      "repeatable": true,
      "max": 4
    }
  }
}
